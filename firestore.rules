rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 0. Global Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    // --- 3. Primitives & Helpers ---
    function isSignedIn() {
      return request.auth != null;
    }

    function isEmailVerified() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128;
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // --- 4. Validation Blueprints ---

    function isValidUser(data) {
      return data.uid == request.auth.uid 
        && (data.displayName == null || data.displayName is string)
        && (data.email == null || data.email is string);
    }

    function isValidHealthLog(data) {
      return data.userId == request.auth.uid
        && data.date is string
        && (data.mood == null || data.mood is string);
    }

    function isValidHealthRisk(data) {
      return data.userId == request.auth.uid;
    }

    function isValidChatMessage(data) {
      return data.userId == request.auth.uid
        && data.role in ['user', 'model'];
    }

    // --- 5. Match Blocks ---
    match /users/{userId} {
      allow read: if isOwner(userId);
      allow create: if isOwner(userId) && isValidUser(incoming());
      allow update: if isOwner(userId);

      match /logs/{logId} {
        allow list: if isOwner(userId);
        allow get: if isOwner(userId);
        allow create: if isOwner(userId) && isValidHealthLog(incoming());
        allow update: if isOwner(userId);
        allow delete: if isOwner(userId);
      }

      match /risks/{riskId} {
        allow list: if isOwner(userId);
        allow get: if isOwner(userId);
        allow create: if isOwner(userId);
      }

      match /chat/{messageId} {
        allow list: if isOwner(userId);
        allow get: if isOwner(userId);
        allow create: if isOwner(userId);
      }
    }
  }
}
